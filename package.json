{
  "name": "lil-invoicer",
  "version": "1.0.0",
  "description": "Littlest invoice tool for the command line.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint",
    "lint:write": "biome lint --write",
    "format": "biome format .",
    "format:write": "biome format --write .",
    "pretest": "npm run build",
    "test": "node --test \"test/**/*.test.mjs\"",
    "build": "tsc",
    "prepare": "lefthook install && tsc && chmod +x dist/index.js"
  },
  "keywords": [],
  "author": "Kasper Koman",
  "license": "ISC",
  "dependencies": {
    "commander": "^15.0.0",
    "glob": "^13.0.6",
    "handlebars": "^4.7.9",
    "js-yaml": "^5.4.2",
    "puppeteer": "^25.12.0"
  },
  "bin": {
    "invoice": "dist/index.js"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.3",
    "lefthook": "^2.1.15",
    "typescript": "^7.0.2"
  }
}
